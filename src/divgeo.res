# Translations are always overridden using XtOverrideTranslations()
# because XmDrawingArea widget does not recognize Enter/LeaveWindow
# from resource file due to an error in Motif

DivGeo*draw.translations: \
			   Shift<Btn1Down>: UseTool(DblClkLeft)\n\
			   Shift<Btn2Down>: UseTool(DblClkMiddle)\n\
			   Shift<Btn3Down>: UseTool(DblClkRight)\n\
			   <Motion>:        UseTool(Motion)\n\
			   <BtnUp>:         UseTool(RelCancel)\n\
			   <EnterWindow>:   UseTool(Enter)\n\
			   <LeaveWindow>:   UseTool(Leave)\n\
			   <Btn1Down>:     UseTool(PressLeft)\n\
			   <Btn2Down>:     UseTool(PressMiddle)\n\
			   <Btn3Down>:     UseTool(PressRight)\n\

