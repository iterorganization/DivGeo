# check if necessary variables are correctly defined
ifndef LD_MSCL
  $(error LD_MSCL not defined)
endif

FC      = pgf90
ifdef SOLPS_DEBUG
FFLAGS = -g -C
else
FFLAGS = -O3
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP	= /lib/cpp -C -traditional

LDLIBS	= ${LD_MSCL} -lstdc++
LDEXTRA	= 

