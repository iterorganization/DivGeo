# check if necessary variables are correctly defined
MSCL_ROOT ?= /pfs/work/g2dpc/SOLPS-ITER/${COMPILER}/mscl
LD_MSCL ?= -L${MSCL_ROOT} -lmscl

FC      = g95
ifdef SOLPS_DEBUG
FFLAGS  = -g -C -ftrace=full -Wall -Wextra
else
FFLAGS  = -O3
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP     = /lib/cpp -C -traditional

LDLIBS  = ${LD_MSCL}
LDEXTRA =

