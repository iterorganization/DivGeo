# check if necessary variables are correctly defined
ifndef MSCL_ROOT
  $(error MSCL_ROOT not defined)
endif
LD_MSCL ?= -L${MSCL_ROOT} -lmscl

FC      = gfortran
ifdef SOLPS_DEBUG
FFLAGS  = -g -C -ffpe-trap=denormal -ffpe-trap=invalid -ffpe-trap=zero -ftrapv -fsignaling-nans
else
FFLAGS  = -O3
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP     = /lib/cpp -C -traditional

LDLIBS  = ${LD_MSCL} -lstdc++
LDEXTRA =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

