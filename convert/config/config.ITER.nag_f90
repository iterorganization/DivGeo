# check if necessary variables are correctly defined
LD_MSCL ?= $(shell pkg-config mscl --libs)

FC       = nagfor
ifdef SOLPS_DEBUG
FFLAGS   = -g -C
else
FFLAGS   = -O3
endif

COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -C -traditional

LDLIBS   = ${LD_MSCL} -lstdc++
LDEXTRA  =

