#  VERSION : 08.02.2002 21:53

# The version relying on Fujitsu Fortran installed on AFS

FC      = f95f -v 6.2d
#FFLAGS	= -g -Am -X9 -AR -fw -Ha -Hs -Hu
#FFLAGS	= -Am -X9 -fw -Kfast,eval -x- -O
ifdef SOLPS_DEBUG
FFLAGS = -g -A2 -Am -X9 -Hasu --trace
else
FFLAGS = -O -A2 -fw -Am -X9 -Kfast,eval
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP	= /lib/cpp -C -traditional

LDLIBS	= -L$(SOLPS_LIB) -lmscl /usr/lib/libstdc++.so.2.9
LDEXTRA	= 
