# check if necessary variables are correctly defined
ifndef LD_MSCL
  $(error LD_MSCL not defined)
endif

FC     = gfortran
ifdef SOLPS_DEBUG
FFLAGS = -g -fcheck=all -fbacktrace
else
FFLAGS = -O3
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP	= /lib/cpp -traditional -ffreestanding

LDLIBS	= ${LD_MSCL} -lstdc++
LDEXTRA	= 
