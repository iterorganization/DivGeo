ifndef LD_MSCL
  ifndef SOLPS_CPP
    $(error LD_MSCL not defined)
  else
    $(error LD_MSCL not defined. Run the install_dependencies script first)
  endif
endif

ifdef (${FC},f77)
FC      = pgf90
endif
ifndef SOLPS_CPP
FFLAGS += -Mnorpath
endif
ifdef SOLPS_DEBUG
FFLAGS += -g -C
else
FFLAGS += -O3
endif

COMPILE = ${FC} -c ${FFLAGS}

LDLIBS  = ${LD_MSCL} -lstdc++
LDEXTRA =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

