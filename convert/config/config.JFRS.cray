# check if necessary variables are correctly defined
LD_MSCL ?= -L/opt/gcc/8.3.0/snos/lib64 -lgfortran -L${SOLPSLIB} -lmscl

FC      = ftn
FFLAGS  = -ez -e0 -ef
ifdef SOLPS_DEBUG
FFLAGS += -O0 -G0 -g -hfp0 -K trap=fp -K trap=divz -Rb
else
FFLAGS += -O3 -hfp3
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP     = /lib/cpp -traditional

LDLIBS  = ${LD_MSCL} -lstdc++
LDEXTRA =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

