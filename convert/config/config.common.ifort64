ifeq (${FC},f77)
FC = ifort
endif
COMPILER_MAJOR_VERSION = $(shell ${FC} -V 2>&1 | grep -o "Version [0-9]*" | cut -d ' ' -f 2 )
ifdef SOLPS_DEBUG
FFLAGS += -g -C -traceback -debug all -diag-disable:10440,10182
else
FFLAGS += -O3
endif
ifeq ($(shell test ${COMPILER_MAJOR_VERSION} -le 12; echo $$?),0)
FFLAGS += -vec_report0
endif

COMPILE = ${FC} -c ${FFLAGS}

LDLIBS  = ${LD_MSCL} -lstdc++
ifeq ($(shell test ${COMPILER_MAJOR_VERSION} -le 12; echo $$?),0)
LDFLAGS = -i_dynamic
endif
LDEXTRA =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
