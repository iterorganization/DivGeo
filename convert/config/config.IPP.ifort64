# check if necessary variables are correctly defined
ifndef MSCL_ROOT
  $(error MSCL_ROOT not defined)
endif
LD_MSCL ?= -L${MSCL_ROOT}/lib -lmscl

FC      = ifort
ifdef SOLPS_DEBUG
FFLAGS  = -g -C -traceback -debug all
else
FFLAGS  = -O3
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP     = /lib/cpp -C -traditional -ffreestanding

LDLIBS  = ${LD_MSCL} -lstdc++
LDEXTRA =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

