# check if necessary variables are correctly defined
MSCL_ROOT ?= /global/project/projectdirs/atom/atom-install-cori/solps-libs/lib_gfortran
LD_MSCL ?= -L${MSCL_ROOT} -lmscl

FC      = ftn
ifdef SOLPS_DEBUG
FFLAGS  = -g -C -ffpe-trap=denormal -ffpe-trap=invalid -ffpe-trap=zero -ftrapv -fsignaling-nans
else
FFLAGS  = -O3
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP     = cpp -C -traditional

LDLIBS  = ${LD_MSCL} -lstdc++
LDEXTRA =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

