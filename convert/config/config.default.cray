# check if necessary variables are correctly defined
ifndef LD_MSCL
  ifndef SOLPS_CPP
    $(error LD_MSCL not defined)
  else
    $(error LD_MSCL not defined. Run the install_dependencies script first.)
  endif
endif

FC      = ftn
FFLAGS  = -ez -e0 -ef
ifdef SOLPS_DEBUG
FFLAGS += -O0 -G0 -g -hfp0 -K trap=fp -K trap=divz -Rb
else
FFLAGS += -O3 -hfp3
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP     = /lib/cpp -traditional

LDLIBS  = ${LD_MSCL} -lstdc++
LDEXTRA =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
