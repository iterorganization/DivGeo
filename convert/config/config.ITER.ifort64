# check if necessary variables are correctly defined
LD_MSCL ?= `pkg-config mscl --libs`

FC      = ifort
FC_VERSION = $(shell echo `ifort --version | head -1 | awk '{printf "%s ",$$3,"\n"}'`)
ifdef SOLPS_DEBUG
FFLAGS = -g -C -traceback -debug all
else
ifeq (${FC_VERSION},18.0.1)
FFLAGS = -O3
else
FFLAGS = -O3 -vec_report0
endif
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP	= /lib/cpp -C -traditional

LDLIBS	= ${LD_MSCL} -lstdc++
ifneq (${FC_VERSION},18.0.1)
LDFLAGS	= -i_dynamic
endif
LDEXTRA	=

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

