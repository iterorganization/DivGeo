# check if necessary variables are correctly defined
LD_MSCL ?= `pkg-config mscl --libs`

FC      = ifort
COMPILER_MAJOR_VERSION = $(shell ${FC} -V 2>&1 | grep -o "Version [0-9]*" | cut -d ' ' -f 2 )
ifdef SOLPS_DEBUG
FFLAGS  = -g -C -traceback -debug all
else
ifeq ($(shell test ${COMPILER_MAJOR_VERSION} -le 12; echo $$?),0)
FFLAGS  = -O3 -vec_report0
else
FFLAGS  = -O3
endif
endif

COMPILE = ${FC} -c ${FFLAGS}
CPP     = /lib/cpp -C -traditional

LDLIBS  = ${LD_MSCL} -lstdc++
ifeq ($(shell test ${COMPILER_MAJOR_VERSION} -le 12; echo $$?),0)
LDFLAGS = -i_dynamic
endif
LDEXTRA =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

