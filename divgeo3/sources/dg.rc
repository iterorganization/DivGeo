#define VER_LEGALTRADEMARKS1_STR    ""
#define VER_LEGALTRADEMARKS2_STR    ""
#define VER_ORIGINALFILENAME_STR    "dg3.exe"
#define VER_PRODUCTNAME_STR         "DivGeo3"

/*#ifndef DEBUG
#define VER_DEBUG                   0
#else
#define VER_DEBUG                   VS_FF_PRIVATEBUILD|VS_FF_PRERELEASE|VS_FF_DEBUG
#endif*/


ID_ICON    ICON    DISCARDABLE    "dg.ico"
