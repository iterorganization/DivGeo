#  VERSION : 29.09.97 20:14

# File compiler.macro for IBM xlf

FC       = xlf
FFLAGS 	 = -g -C -qflttrap=enable:overflow:zerodivide:invalid -qsigtrap -qfloat=nofold:nohssngl
FFLAGS   = -O -qMAXMEM=-1 -qST_SIZE=5000 -qTKQ_SIZE=30000 -qAUX_SIZE=50000 -qrealsize=8 -qextchk -qfloat=rsqrt:hssngl:fltint # -Q -qipa -qattr=full -qhot
FFLAGS   = -O
COMPILE  = ${FC} -c ${FFLAGS}
CPP	 = /lib/cpp

ifeq ($(shell [ -e ${SOLPSTOP}/src/lib/${OBJECTCODE} ] && echo yes || echo no ),yes)
LDLIBS   = -L${SOLPSTOP}/src/lib/${OBJECTCODE} -L/usr/local/lib -L/usr/lpp/xlC/lib
else
LDLIBS   = -L${SOLPSTOP}/lib/${OBJECTCODE} -L/usr/local/lib -L/usr/lpp/xlC/lib
endif
LDFLAGS  = -lmscl -lnag
LDEXTRA	 =
