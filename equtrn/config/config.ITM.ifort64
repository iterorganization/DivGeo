# check if necessary variables are correctly defined
ifndef LD_MSCL
  $(error LD_MSCL not defined)
endif

FC       = ifort 
ifdef SOLPS_DEBUG
FFLAGS   = -g -C -traceback
else
FFLAGS   = -O
endif
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -C -traditional -ffreestanding

DEFINES  = ${SOLPS_CPP}
LDLIBS   = ${LD_MSCL}
LDFLAGS  = 

ifdef IMAS_VERSION
UAL_MAJOR_VERSION ?= $(shell echo ${UAL_VERSION} | cut -d '.' -f1 )
GGD_MINOR_VERSION ?= $(shell echo ${EBVERSIONGGD} | cut -d '.' -f2 )
IMAS_MAJOR_VERSION ?= $(shell echo ${IMAS_VERSION} | cut -d '.' -f1 )
IMAS_MINOR_VERSION ?= $(shell echo ${IMAS_VERSION} | cut -d '.' -f2 )
ifndef SOLPS_CPP
EQUIVS    += -DIMAS -DUAL_MAJOR_VERSION=${UAL_MAJOR_VERSION} -DIMAS_MINOR_VERSION=${IMAS_MINOR_VERSION} -DGGD_MINOR_VERSION=${GGD_MINOR_VERSION}
endif
LD_UAL    ?= `pkg-config imas-ifort ggd --libs`
INCMODS   += `pkg-config imas-ifort ggd --cflags`
endif

#LDWOS   = -L/usr/ads/lib/ -lKK -lwoss -lddww -lpplotXt -R/usr/ads/lib/:/opt/SUNWspro/lib/ -lsocket
#LDWOS   = -L/afs/ipp-garching.mpg.de/aug/ads/lib64/@sys -lKK -lwoss -lddww -lpplotXt -lsocket
#LDWOS   = -L/afs/ipp-garching.mpg.de/aug-ads/@sys/lib64 -Wl,-R/afs/ipp-garching.mpg.de/aug-ads/@sys/lib64 -lkk -lddww

