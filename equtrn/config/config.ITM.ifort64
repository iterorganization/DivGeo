# check if necessary variables are correctly defined
MSCL_ROOT ?= /pfs/work/g2dpc/SOLPS-ITER/${COMPILER}/mscl
LD_MSCL   ?= -L${MSCL_ROOT}/lib -lmscl

FC       = ifort
ifdef SOLPS_DEBUG
FFLAGS   = -g -C -traceback
else
FFLAGS   = -O
endif
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -C -traditional -ffreestanding

DEFINES  = ${SOLPS_CPP}
LDLIBS   = ${LD_MSCL}
LDFLAGS  =

ifdef IMAS_VERSION
GGD_VERSION ?= `pkg-config ggd --modversion`
UAL_MAJOR_VERSION ?= $(shell echo ${UAL_VERSION} | cut -d '.' -f1 )
IMAS_MAJOR_VERSION ?= $(shell echo ${IMAS_VERSION} | cut -d '.' -f1 )
IMAS_MINOR_VERSION ?= $(shell echo ${IMAS_VERSION} | cut -d '.' -f2 )
ifeq ($(shell test ${IMAS_MINOR_VERSION} -ge 15; echo $$?),0)
GGD_MINOR_VERSION ?= $(shell echo ${GGD_VERSION} | cut -d '.' -f2 )
LD_UAL    ?= `pkg-config imas-ifort ggd --libs` -lstdc++
INCMODS   += `pkg-config imas-ifort ggd --cflags`
else
ifeq ($(shell test ${IMAS_MINOR_VERSION} -ge 12; echo $$?),0)
GGD_MINOR_VERSION ?= $(shell echo ${GGD_VERSION} | cut -d '.' -f2 )
LD_UAL    ?= `pkg-config imas-ifort --libs` -lggd-ifort -lstdc++
INCMODS   += `pkg-config imas-ifort --cflags`
else
GGD_MINOR_VERSION ?= 0
LD_UAL    ?= `pkg-config imas-lowlevel imas-ifort --libs` -lstdc++
INCMODS   += `pkg-config imas-lowlevel imas-ifort --cflags`
endif
endif
ifndef SOLPS_CPP
DEFINES   += -DIMAS -DUAL_MAJOR_VERSION=${UAL_MAJOR_VERSION} -DIMAS_MINOR_VERSION=${IMAS_MINOR_VERSION} -DGGD_MINOR_VERSION=${GGD_MINOR_VERSION}
endif
endif

