#LDWOS   = -L/afs/ipp-garching.mpg.de/aug/ads/lib64/@sys -lKK -lwoss -lddww -lpplotXt -lsocket
#LDWOS   = -L/afs/ipp-garching.mpg.de/aug-ads/@sys/lib64 -Wl,-R/afs/ipp-garching.mpg.de/aug-ads/@sys/lib64 -lkk -lddww

