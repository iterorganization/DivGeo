COMPILER_MAJOR_VERSION = $(shell ${FC} -V 2>&1 | grep -o "Version [0-9]*" | cut -d ' ' -f 2 )
ifdef SOLPS_DEBUG
FFLAGS  += -g -C -traceback
else
FFLAGS  += -O
endif
COMPILE  = ${FC} -c ${FFLAGS} -module ${OBJDIR}

ifdef SOLPS_CPP
DEFINES  = ${SOLPS_CPP}
else
endif
ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
ifndef SOLPS_CPP
DEFINES += -DCONSTANTS_PROVIDED
endif
INCMODS += `pkg-config fundamental-constants --cflags`
endif

LDLIBS   = ${LD_MSCL}
LDFLAGS  =
ifeq ($(shell test ${COMPILER_MAJOR_VERSION} -le 12; echo $$?),0)
FFLAGS  += -vec_report0
LDFLAGS += -i_dynamic
endif

ifdef IMAS_VERSION
UAL_MAJOR_VERSION ?= $(shell echo ${UAL_VERSION} | cut -d '.' -f1 )
UAL_MINOR_VERSION ?= $(shell echo ${UAL_VERSION} | cut -d '.' -f2 )
UAL_MICRO_VERSION ?= $(shell echo ${UAL_VERSION} | cut -d '.' -f3 )
IMAS_MAJOR_VERSION ?= $(shell echo ${IMAS_VERSION} | cut -d '.' -f1 )
IMAS_MINOR_VERSION ?= $(shell echo ${IMAS_VERSION} | cut -d '.' -f2 )
ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
LD_UAL  := `pkg-config imas-ifort --libs`
INCMODS += `pkg-config imas-ifort --cflags`
else
ifeq ($(shell test ${IMAS_MINOR_VERSION} -le 34; echo $$?),0)
LD_UAL  := `pkg-config imas-ifort imas-constants-ifort --libs`
INCMODS += `pkg-config imas-ifort imas-constants-ifort --cflags`
else
LD_UAL  := `pkg-config imas-ifort --libs`
INCMODS += `pkg-config imas-ifort --cflags`
endif
endif
ifeq ($(shell test ${IMAS_MINOR_VERSION} -ge 17; echo $$?),0)
GGD_MINOR_VERSION ?= $(shell echo ${GGD_VERSION} | cut -d '.' -f2 )
LD_UAL  += `pkg-config ggd --libs`
INCMODS += `pkg-config ggd --cflags`
else
ifeq ($(shell test ${IMAS_MINOR_VERSION} -ge 12; echo $$?),0)
GGD_MINOR_VERSION ?= $(shell echo ${GGD_VERSION} | cut -d '.' -f2 )
LD_UAL  += -lggd-ifort
else
GGD_MINOR_VERSION = 0
LD_UAL  += `pkg-config imas-lowlevel --libs`
INCMODS += `pkg-config imas-lowlevel --cflags`
endif
endif
ifndef SOLPS_CPP
DEFINES += -DIMAS -DUAL_MAJOR_VERSION=${UAL_MAJOR_VERSION} -DUAL_MINOR_VERSION=${UAL_MINOR_VERSION} -DUAL_MICRO_VERSION=${UAL_MICRO_VERSION} -DIMAS_MINOR_VERSION=${IMAS_MINOR_VERSION} -DGGD_MINOR_VERSION=${GGD_MINOR_VERSION}
endif
endif

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

