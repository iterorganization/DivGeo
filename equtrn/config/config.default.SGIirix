#  VERSION : 29.05.95 20:00

# check if necessary variables are correctly defined
ifndef LD_MSCL
$(error LD_MSCL not defined)
endif

# File compiler.macro for SGI f77

FC       = f77
FFLAGS   = -static -r8 -O2 -nocpp
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp

ifdef SOLPS_CPP
  DEFINES  = ${SOLPS_CPP}
  ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
    CONSTANTS_MINOR_VERSION = $(shell pkg-config fundamental-constants --modversion | cut -d '.' -f 2)
    DEFINES += -DCONSTANTS_PROVIDED  -DCONSTANTS_MINOR_VERSION=${CONSTANTS_MINOR_VERSION}
    INCLUDE += $(shell pkg-config fundamental-constants --cflags)
    IMAS_PKG_LIST = fundamental-constants
  endif
endif

ifdef IMAS_PKG_LIST
  INCMODS += $(shell pkg-config ${IMAS_PKG_LIST} --cflags)
endif

MOD = mod

LDLIBS   = ${LD_MSCL} -L/afs/ipp-garching.mpg.de/@sys/lib -L/usr/local/lib -L/usr/lpp/xlC/lib
LDFLAGS  = ${LD_NAG} -lslap -lmach -lblas -lxersla -lnagblas -lC -ldumsgi
LDEXTRA  =

# LDUMLIB = -lnagblas -lC

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:
