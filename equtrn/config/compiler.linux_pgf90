FC	 = pgf90
FFLAGS	 = -g
COMPILE  = ${FC} -c ${FFLAGS}
CPP	 = /lib/cpp -traditional

ifeq ($(shell [ -e ${SOLPS_LIB} ] && echo yes || echo no ),yes)
LDLIBS   = -L${SOLPS_LIB}
else
LDLIBS   = -L${SOLPS_LIB}
endif
LDFLAGS  = -lmscl ${SOLPS_LIBS}

LDWOS 	 = -L/usr/ads/lib/ -lKK -lwoss -lddww -lpplotXt -R/usr/ads/lib/:/opt/SUNWspro/lib/ -lsocket
LDFLUSH  = -lflush -lnag -lppf
