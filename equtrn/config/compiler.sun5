FC	 = f90
FFLAGS 	 = -g
COMPILE  = ${FC} -c ${FFLAGS}
CPP	 = /usr/ccs/lib/cpp

ifeq ($(shell [ -e ${SOLPSTOP}/src/lib/${OBJECTCODE} ] && echo yes || echo no ),yes)
LDLIBS   = -L${SOLPSTOP}/src/lib/${OBJECTCODE}
else
LDLIBS   = -L${SOLPSTOP}/lib/${OBJECTCODE}
endif
LDFLAGS  = -lmscl ${SOLPS_LIBS} -lf77compat

LDWOS 	 = -L/usr/ads/lib/ -lKK -lwoss -lddww -lpplotXt -R/usr/ads/lib/:/opt/SUNWspro/lib/ -lsocket
