#  VERSION : 24.10.2000 19:49

# check if necessary variables are correctly defined
ifndef LD_MSCL
$(error LD_MSCL not defined)
endif

# File compiler.macro for Fujitsu f95f

FC       = f95f
FFLAGS   = -O --tpp
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -C -traditional

ifdef SOLPS_CPP
  DEFINES  = ${SOLPS_CPP}
  ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
    DEFINES += -DCONSTANTS_PROVIDED
    INCLUDE += `pkg-config fundamental-constants --cflags`
    IMAS_PKG_LIST = fundamental-constants
  endif
endif

ifdef IMAS_PKG_LIST
  INCMODS += `pkg-config ${IMAS_PKG_LIST} --cflags`
endif

MOD = mod

LDLIBS   = -${LD_MSCL} -L/usr/local/lib
LDFLAGS  = -lnag
LDEXTRA  =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

