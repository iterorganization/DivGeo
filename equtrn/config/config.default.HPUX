#  VERSION : 28.08.98 10:15

# check if necessary variables are correctly defined
ifndef LD_MSCL
$(error LD_MSCL not defined)
endif

# File compiler.macro for HPUX FORTRAN compiler

FC       = f77
FFLAGS   = -g -C +FPOZV
FFLAGS   = +O3 -R8 
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp

ifdef SOLPS_CPP
  DEFINES  = ${SOLPS_CPP}
  ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
    DEFINES += -DCONSTANTS_PROVIDED
    IMAS_PKG_LIST = fundamental-constants
  endif
else
  DEFINES += -DHPUX
endif

ifdef IMAS_PKG_LIST
  INCMODS += `pkg-config ${IMAS_PKG_LIST} --cflags`
endif

LDLIBS   = -Wl,${LD_MSCL} -Wl,-L/usr/local/lib
LDFLAGS  = 
LDEXTRA  =

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

