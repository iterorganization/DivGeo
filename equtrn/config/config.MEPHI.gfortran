# check if necessary variables are correctly defined
ifndef LD_MSCL
  $(error LD_MSCL not defined)
endif

FC       = gfortran
ifdef SOLPS_DEBUG
FFLAGS	 = -g -fcheck=all -fbacktrace -ffpe-trap=denormal
else
FFLAGS	 = -O
endif
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -traditional

DEFINES  = ${SOLPS_CPP}
LDLIBS   = ${LD_MSCL}
LDFLAGS  = 

