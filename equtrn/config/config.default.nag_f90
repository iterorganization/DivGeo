# check if necessary variables are correctly defined
ifndef LD_MSCL
  ifndef SOLPS_CPP
    $(error LD_MSCL not defined)
  else
    $(error LD_MSCL not defined. Run the install_dependencies script first.)
  endif
endif

FC       = nagfor
FFLAGS   = -g
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -traditional

ifdef SOLPS_CPP
  DEFINES  = ${SOLPS_CPP}
  ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
    DEFINES += -DCONSTANTS_PROVIDED
    INCLUDE += `pkg-config fundamental-constants --cflags`
    IMAS_PKG_LIST = fundamental-constants
  endif
else
  DEFINES += -DNAGFOR
endif

ifdef IMAS_PKG_LIST
  INCMODS += `pkg-config ${IMAS_PKG_LIST} --cflags`
endif

MOD = mod

LDLIBS   = ${LD_MSCL}
LDFLAGS  =

LDWOS    = -L/usr/ads/lib -lKK -lwoss -lddww -lpplotXt -R/usr/ads/lib/:/opt/SUNWspro/lib/ -lsocket
LDFLUSH  = -lflush ${LD_NAG} -lppf

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

