# check if necessary variables are correctly defined
IRISLIB ?= /fusion/projects/codes/solps/SOLPS-ITER/public_lib/GA.ifort64 
MSCL_ROOT ?= ${IRISLIB}
LD_MSCL ?= -L${MSCL_ROOT} -lmscl

FC       = ifort 
ifdef SOLPS_DEBUG
FFLAGS   = -g -C -traceback
else
FFLAGS   = -O
endif
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -C -traditional

LDLIBS   = ${LD_MSCL}
LDFLAGS  = 

