# check if necessary variables are correctly defined
#ifndef MSCL_ROOT
#  $(error MSCL_ROOT not defined)
#endif
MSCL_ROOT ?= /usr/local/mscl/linux_gfortran_JDL
LD_MSCL ?= -L${MSCL_ROOT} -lmscl

FC       = gfortran
ifdef SOLPS_DEBUG
FFLAGS   = -g -C -ffpe-trap=denormal
else
FFLAGS   = -O3
endif
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -traditional

ifdef SOLPS_CPP
DEFINES  = ${SOLPS_CPP}
else
DEFINES += -DGFORTRAN
endif
LDLIBS   = ${LD_MSCL}
LDFLAGS  = 

#LDWOS   = -L/usr/ads/lib/ -lKK -lwoss -lddww -lpplotXt -R/usr/ads/lib/:/opt/SUNWspro/lib/ -lsocket


