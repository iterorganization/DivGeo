# check if necessary variables are correctly defined
ifndef LD_MSCL
  LD_MSCL = -L${SOLPSLIB} -lmscl
endif

FC	 = g95
ifdef SOLPS_DEBUG
FFLAGS	 = -g -C -ftrace=full
else
FFLAGS	 = -O
endif
COMPILE  = ${FC} -c ${FFLAGS}
CPP	     = /lib/cpp -C -traditional

LDLIBS   = ${LD_MSCL}
LDFLAGS  = 

