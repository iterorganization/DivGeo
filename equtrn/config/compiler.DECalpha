
# File compiler.macro for IBM xlf

FC	= f77
CPP	= /usr/ucb/cpp -DNOB2GXDR
FFLAGS	= -r8 -i4 -fast
COMPILE	= ${FC} -c ${FFLAGS}

ifeq ($(shell [ -e ${SOLPSTOP}/src/lib/${OBJECTCODE} ] && echo yes || echo no ),yes)
LDLIBS	= -L${SOLPSTOP}/src/lib/${OBJECTCODE} -L${SOLPSMASTER}/@sys/lib -L/usr/local/lib
else
LDLIBS	= -L${SOLPSTOP}/lib/${OBJECTCODE} -L${SOLPSMASTER}/@sys/lib -L/usr/local/lib
endif
LDFLAGS = -lblas -lnag -lslap -lmmach -lxersla -lmscl -lsonnet3.1 -lnetcdf ${SOLPS_LIBS}

