# check if necessary variables are correctly defined
ifndef LD_MSCL
$(error LD_MSCL not defined)
endif

# File compiler.macro for IBM xlf

FC       = f77
CPP      = /usr/ucb/cpp -C -DNOB2GXDR
FFLAGS   = -r8 -i4 -fast
COMPILE  = ${FC} -c ${FFLAGS}

ifdef SOLPS_CPP
  DEFINES  = ${SOLPS_CPP}
  ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
    DEFINES += -DCONSTANTS_PROVIDED
    INCLUDE += `pkg-config fundamental-constants --cflags`
    IMAS_PKG_LIST = fundamental-constants
  endif
endif

ifdef IMAS_PKG_LIST
  INCMODS += `pkg-config ${IMAS_PKG_LIST} --cflags`
endif

LDLIBS   = -L${SOLPSLIB} -L/usr/local/lib
LDFLAGS  = -lblas ${LD_NAG} -lslap -lmmach -lxersla ${LD_MSCL} ${LD_NETCDF}


#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

