# check if necessary variables are correctly defined
ifndef LD_MSCL
$(error LD_MSCL not defined)
endif

# File compiler.macro for IBM xlf

FC       = f77
CPP      = /usr/ucb/cpp -C -DNOB2GXDR
FFLAGS   = -r8 -i4 -fast
COMPILE  = ${FC} -c ${FFLAGS}

ifdef SOLPS_CPP
DEFINES  = ${SOLPS_CPP}
endif
ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
ifndef SOLPS_CPP
DEFINES += -DCONSTANTS_PROVIDED
endif
INCMODS += `pkg-config fundamental-constants --cflags`
endif

LDLIBS   = -L${SOLPSLIB} -L/usr/local/lib
LDFLAGS  = -lblas ${LD_NAG} -lslap -lmmach -lxersla ${LD_MSCL} ${LD_SONNET} ${LD_NETCDF}


#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

