# check if necessary variables are correctly defined
ifndef LD_MSCL
$(error LD_MSCL not defined)
endif


# File compiler.macro for IBM xlf

FC	= f77
CPP	= /usr/ucb/cpp -DNOB2GXDR
FFLAGS	= -r8 -i4 -fast
COMPILE	= ${FC} -c ${FFLAGS}

LDLIBS	= -L${SOLPSMASTER}/@sys/lib -L/usr/local/lib
LDFLAGS = -lblas -lnag -lslap -lmmach -lxersla ${LD_MSCL} -lsonnet3.1 -lnetcdf

