#  VERSION : 29.05.95 20:00

# File compiler.macro for SGI f77

FC       = f77
FFLAGS   = -static -r8 -O2 -nocpp
COMPILE  = ${FC} -c ${FFLAGS}
CPP	 = /lib/cpp

ifeq ($(shell [ -e ${SOLPSTOP}/src/lib/${OBJECTCODE} ] && echo yes || echo no ),yes)
LDLIBS   = -L${SOLPSTOP}/src/lib/${OBJECTCODE} -L/afs/ipp-garching.mpg.de/@sys/lib -L/usr/local/lib -L/usr/lpp/xlC/lib
else
LDLIBS   = -L${SOLPSTOP}/lib/${OBJECTCODE} -L/afs/ipp-garching.mpg.de/@sys/lib -L/usr/local/lib -L/usr/lpp/xlC/lib
endif
LDFLAGS  = -lnag -lslap -lmach -lblas -lxersla -lsonnet -lnagblas -lC -ldumsgi
LDEXTRA	 =

# LDUMLIB = -lnagblas -lC
