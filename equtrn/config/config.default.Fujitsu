# check if necessary variables are correctly defined
ifndef LD_MSCL
$(error LD_MSCL not defined)
endif

FC       = f95f
FFLAGS   = -g -X9
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -C -traditional

ifdef SOLPS_CPP
  DEFINES  = ${SOLPS_CPP}
  ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
    DEFINES += -DCONSTANTS_PROVIDED
    IMAS_PKG_LIST = fundamental-constants
  endif
endif

ifdef IMAS_PKG_LIST
  INCMODS += `pkg-config ${IMAS_PKG_LIST} --cflags`
endif

LDLIBS   = ${LD_MSCL}
LDFLAGS  = 

LDWOS    = -L/usr/ads/lib -lKK -lwoss -lddww -lpplotXt -R/usr/ads/lib/:/opt/SUNWspro/lib/ -lsocket

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

