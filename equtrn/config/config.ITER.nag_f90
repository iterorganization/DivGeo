# check if necessary variables are correctly defined
LD_MSCL  ?= `pkg-config mscl --libs`

FC       = nagfor
ifdef SOLPS_DEBUG
FFLAGS   = -g
else
FFLAGS   =
endif
COMPILE  = ${FC} -c ${FFLAGS} -mdir ${OBJDIR} -I${OBJDIR}
CPP      = /lib/cpp -traditional

ifdef SOLPS_CPP
DEFINES  = ${SOLPS_CPP}
else
DEFINES += -DNAGFOR
endif
ifeq ($(shell `pkg-config --exists fundamental-constants`; echo $$?),0)
ifndef SOLPS_CPP
DEFINES += -DCONSTANTS_PROVIDED
endif
INCMODS += `pkg-config fundamental-constants --cflags`
endif
LDLIBS   = ${LD_MSCL}
LDFLAGS  =

LDWOS    = -L/usr/ads/lib/ -lKK -lwoss -lddww -lpplotXt -R/usr/ads/lib/:/opt/SUNWspro/lib/ -lsocket
LDFLUSH  = -lflush ${LD_NAG} -lppf

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

