# check if necessary variables are correctly defined
MSCL_ROOT ?= /u/eemdee/linux_gfortran/lib
LD_MSCL ?= -L${MSCL_ROOT} -lmscl

FC      ?= gfortran
ifndef SOLPS_DEBUG
FFLAGS   = -O3
endif
CPP      = /lib/cpp -traditional

ifeq ($(shell `pkg-config --exists ggd`; echo $$?),0)
GGD_VERSION ?= `pkg-config ggd --modversion`
else
GGD_VERSION ?= '0.0.0'
endif

