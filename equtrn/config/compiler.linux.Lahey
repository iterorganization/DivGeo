#  VERSION : 24.10.2000 19:49

# File compiler.macro for Fujitsu f95f

FC       = f95f
FFLAGS   = -O --tpp
COMPILE  = ${FC} -c ${FFLAGS}
CPP	 = /lib/cpp -C -traditional

ifeq ($(shell [ -e ${SOLPSTOP}/src/lib/${OBJECTCODE} ] && echo yes || echo no ),yes)
LDLIBS   = -L${SOLPSTOP}/src/lib/${OBJECTCODE} -L/usr/local/lib
else
LDLIBS   = -L${SOLPSTOP}/lib/${OBJECTCODE} -L/usr/local/lib
endif
LDFLAGS  = -lmscl -lnag
LDEXTRA	 =
