# check if necessary variables are correctly defined
MSCL_ROOT ?= /pfs/work/g2dpc/SOLPS-ITER/${COMPILER}/mscl
LD_MSCL ?= -L${MSCL_ROOT} -lmscl

FC       = gfortran
ifdef SOLPS_DEBUG
FFLAGS   = -g -fcheck=all -fbacktrace -ffpe-trap=denormal -ffpe-trap=invalid -ffpe-trap=zero -ftrapv -fsignaling-nans
else
FFLAGS   = -O
endif
COMPILE  = ${FC} -c ${FFLAGS}
CPP      = /lib/cpp -traditional

ifdef SOLPS_CPP
DEFINES  = ${SOLPS_CPP}
else
DEFINES  = -DGFORTRAN
endif
LDLIBS   = ${LD_MSCL}
LDFLAGS  = 

#LDWOS   = -L/usr/ads/lib/ -lKK -lwoss -lddww -lpplotXt -R/usr/ads/lib/:/opt/SUNWspro/lib/ -lsocket
#LDWOS   = -L/afs/ipp/aug/ads/lib64/@sys -lKK -lwoss -lddww -lpplotXt -lsocket
#LDWOS   = -L/afs/ipp/aug-ads/@sys/lib64 -Wl,-R/afs/ipp/aug-ads/@sys/lib64 -lkk -lddww

