# check if necessary variables are correctly defined
MSCL_ROOT ?= ${EBROOTMSCL}
LD_MSCL ?= `pkg-config mscl --libs`

ifdef SOLPS_DEBUG
FFLAGS   = -fcheck=all -fbacktrace
else
FFLAGS   = -O
endif
CPP      = /lib/cpp -traditional

ifeq ($(shell `pkg-config --exists ggd`; echo $$?),0)
GGD_VERSION ?= `pkg-config ggd --modversion`
else
GGD_VERSION ?= '0.0.0'
endif

LDEXTRA += -lstdc++

#!!!Local Variables:
#!!! mode: Makefile
#!!! End:

